# 依赖
node_modules/

# 环境变量（含 API Key，绝不提交）
.env

# 构建产物
dist/
*.tsbuildinfo
# 前端构建产物（源码在 src/client/，由 npm run build:client 生成）
src/server/public/
# 桌面端构建产物（源码在 desktop/*.ts，由 npm run build:desktop 生成）
desktop/build/
# 本地跑服务的临时打包产物（esbuild 输出，仅供自检/调试）
src/server/.dev-server.mjs

# 日志
*.log

# 编辑器
.vscode/
.idea/
.DS_Store

# ZCode 内部文件
.zcode/

# Playwright 测试产物
.playwright-mcp/

# Web 设置页保存的供应商/模型覆盖配置（含 API Key，绝不提交）
.web-config.json
.web-config.json.bak
.web-config.json.tmp
.web-config.json.lock

# ZCode 本地目录（日志/临时脚本）
.setting/

# Docker Compose 挂载的数据卷（配置/journal/审计，含密钥，绝不提交）
data/

# 开发过程内部文档（架构计划/阶段清单/攻面分析）——公开仓库不下发
.plans/
