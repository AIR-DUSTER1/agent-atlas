# ============================================================
# production.env.example — 单实例生产环境模板
# ============================================================
# 复制为 production.env，填写真实值后执行：
#   docker compose --env-file production.env -f docker-compose.production.yml up -d
# production.env 含密钥，已被 gitignore；不要提交、不要打进镜像。

# 必填：不可变镜像 digest（不要使用 latest 或可覆盖 tag）
AGENT_IMAGE=registry.example.com/agentatlas@sha256:REPLACE_WITH_IMAGE_DIGEST
AGENT_DATA_DIR=/srv/agentatlas/data
AGENT_PORT=3000
# 多用户生产后端；桌面端/本地开发不设置时默认 file
STATE_BACKEND=postgres
DATABASE_URL=postgresql://agent_app:change-me-app-password@postgres:5432/agentatlas
DATABASE_ADMIN_URL=postgresql://agent:change-me-admin-password@postgres:5432/agentatlas
DATABASE_POOL_MAX=10
# 同机 Docker 网络用 disable；托管 PostgreSQL 用 require
DATABASE_SSL=disable
BOOTSTRAP_ADMIN_NAME=管理员
# 同机 PostgreSQL 叠加层需要；使用外部托管数据库时忽略
POSTGRES_IMAGE=postgres:16-alpine@sha256:REPLACE_WITH_POSTGRES_DIGEST
POSTGRES_DB=agentatlas
POSTGRES_ADMIN_USER=agent
POSTGRES_ADMIN_PASSWORD=change-me-admin-password
POSTGRES_APP_PASSWORD=change-me-app-password

# 必填：管理员 bootstrap/首次设备配对密钥，至少 16 位；普通用户使用独立访问令牌
AUTH_TOKEN=change-me-to-a-long-random-login-secret
# 必填：随机设备/会话签名密钥，至少 32 位（openssl rand -base64 48）
SESSION_SECRET=change-me-to-a-long-random-session-secret
# 必填：32 字节 base64（openssl rand -base64 32）
DATA_KEY=change-me
SESSION_TTL_HOURS=12
DEVICE_TTL_DAYS=180
# 推荐：Prometheus 抓取专用只读令牌，不授予控制面 API
METRICS_TOKEN=change-me-to-a-random-metrics-token

# 首次启动必须提供一个可用模型；启动后可改由 Web 设置管理
BASE_URL=https://api.example.com/v1
API_KEY=
MODEL=replace-with-supported-model
AI_PROTOCOL=openai

# 可选：结论地图；Key 仅在服务端静态图代理中使用
MAP_PROVIDER=amap
AMAP_WEB_SERVICE_KEY=
TENCENT_MAP_KEY=
BAIDU_MAP_AK=

LOG_LEVEL=info
TZ=Asia/Shanghai
# 默认生产镜像已内置 Chrome Headless Shell；仅自定义镜像时覆盖：
# BROWSER_USE_EXECUTABLE_PATH=/opt/chrome-headless-shell/chrome-headless-shell
# 默认镜像已设置容器模式；不要在桌面端启用。
# BROWSER_USE_CONTAINER=1
# JOB_BROWSER_HEADLESS=1
BACKUP_KEEP_LATEST=7
BACKUP_KEEP_DAYS=7
