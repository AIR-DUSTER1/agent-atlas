# ============================================================
# production.env.example — 单实例生产环境模板
# ============================================================
# 复制为 production.env，填写真实值后执行：
#   docker compose --env-file production.env -f docker-compose.production.yml up -d
# production.env 含密钥，已被 gitignore；不要提交、不要打进镜像。

# 必填：不可变镜像 digest（不要使用 latest 或可覆盖 tag）
AGENT_IMAGE=registry.example.com/agent@sha256:REPLACE_WITH_IMAGE_DIGEST
AGENT_DATA_DIR=./data
AGENT_PORT=3000

# 必填：随机登录引导密钥，至少 16 位
AUTH_TOKEN=change-me-to-a-long-random-login-secret
# 必填：随机会话签名密钥，至少 32 位（openssl rand -base64 48）
SESSION_SECRET=change-me-to-a-long-random-session-secret
# 必填：32 字节 base64（openssl rand -base64 32）
DATA_KEY=change-me
SESSION_TTL_HOURS=12
# 推荐：Prometheus 抓取专用只读令牌，不授予控制面 API
METRICS_TOKEN=change-me-to-a-random-metrics-token

# 首次启动必须提供一个可用模型；启动后可改由 Web 设置管理
BASE_URL=https://api.example.com/v1
API_KEY=
MODEL=replace-with-supported-model
AI_PROTOCOL=openai

LOG_LEVEL=info
TZ=Asia/Shanghai
BACKUP_KEEP_LATEST=7
BACKUP_KEEP_DAYS=7
