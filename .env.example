# ===== LangGraph Demo 环境变量模板 =====
# 复制本文件为 .env 并填入真实值（.env 已被 .gitignore 忽略，不会提交）

# 兼容 OpenAI 格式的 API 地址（chat/completions）
BASE_URL=https://tokenrhythm.studio/v1

# API Key
API_KEY=sk_tr_xxx

# 模型名 —— 必须填网关「支持」的模型！
# 运行 `npm run models` 可查看网关支持的完整列表（deepseek-v4-flash 实测可用）
MODEL=deepseek-v4-flash

# 请求协议（可选，默认 openai）
#   openai            OpenAI Chat Completions（{BASE_URL}/chat/completions）
#   openai-responses  OpenAI Responses API（{BASE_URL}/responses）
#   anthropic         Anthropic Messages 原生（{BASE_URL}/v1/messages）
#   gemini            Gemini 原生 generateContent（{BASE_URL}/v1beta/…）
AI_PROTOCOL=openai

# 说明：一个网关往往有多个模型，且「思考等级」各家划分不一样 ——
# 这些都在 Web 设置页里配置（供应商 × 多模型 + 思考等级档位），
# 保存在 .web-config.json，优先级高于本文件。详见 README「思考等级」一节。

# ===== 部署 / 运维（可选）=====
# 监听地址：默认 127.0.0.1；对外开放必须同时设置 AUTH_TOKEN
# HOST=0.0.0.0
# PORT=3000
# Bearer 认证令牌（设置后 /api/* 需要 Authorization: Bearer <token>）
# AUTH_TOKEN=change-me
# 结构化日志级别：debug / info / warn / error / silent
# LOG_LEVEL=info
