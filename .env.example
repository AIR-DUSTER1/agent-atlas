# ===== agentatlas 环境变量模板 =====
# 复制本文件为 .env 并填入真实值（.env 已被 .gitignore 忽略，不会提交）

# 兼容 OpenAI 格式的 API 地址（chat/completions）
BASE_URL=https://tokenrhythm.studio/v1

# API Key
API_KEY=sk_tr_xxx

# 模型名 —— 必须填网关「支持」的模型！
# 运行 `npm run models` 可查看网关支持的完整列表（deepseek-v4-flash 实测可用）
MODEL=deepseek-v4-flash

# 请求协议（可选，默认 openai）
#   openai            OpenAI Chat Completions（{BASE_URL}/chat/completions）
#   openai-responses  OpenAI Responses API（{BASE_URL}/responses）
#   anthropic         Anthropic Messages 原生（{BASE_URL}/v1/messages）
#   gemini            Gemini 原生 generateContent（{BASE_URL}/v1beta/…）
AI_PROTOCOL=openai

# 长任务不设置业务层执行时长 / 工具次数 / 模型次数上限；图运行统一使用 1000 超步兜底
# 审批与工具等待不设自动超时；只有模型请求超时/失败会触发供应商重试或最终报错
# 单次模型 HTTP 请求超时（默认 90 秒）
# MODEL_REQUEST_TIMEOUT_MS=90000
# 模型请求失败后的自动重试次数（默认 10；400/401 等确定性错误不重试）
# MODEL_REQUEST_RETRIES=10

# 说明：一个网关往往有多个模型，且「思考等级」各家划分不一样 ——
# 这些都在 Web 设置页里配置（供应商 × 多模型 + 思考等级档位），
# 保存在 .web-config.json，优先级高于本文件。详见 README「思考等级」一节。

# ===== 结论地图（可选，默认高德原生瓦片）=====
# provider: amap / tencent / baidu / osm / custom
# 结论表不创建 iframe。高德/腾讯/百度配置对应 Web 服务 Key 后由服务端代理官方静态图；无 Key/上游失败时回退原生瓦片。
# Key 只留在服务端，不下发浏览器；请在控制台按部署服务器公网 IP 设置白名单。
# AMAP_WEB_SERVICE_KEY=
# 腾讯位置服务 WebService Key（控制台按服务器出口 IP 设置白名单）
# TENCENT_MAP_KEY=
# 百度地图服务端 AK（控制台按服务器出口 IP 设置白名单）
# BAIDU_MAP_AK=
# MAP_TILE_URL 仍可覆盖内置瓦片模板。
# 模板占位符：{s}=子域，{x}/{y}/{z}=瓦片坐标；可把浏览器可见的 key 放在查询串。
# MAP_PROVIDER=amap
# MAP_LABEL=高德地图
# MAP_TILE_URL=https://{s}.is.autonavi.com/appmaptile?style=8&x={x}&y={y}&z={z}
# MAP_SUBDOMAINS=webst01,webst02,webst03,webst04
# coordinateSystem: wgs84 / gcj02 / bd09；projection: web-mercator / baidu；yAxis: xyz / tms
# MAP_COORDINATE_SYSTEM=gcj02
# MAP_PROJECTION=web-mercator
# MAP_Y_AXIS=xyz
# MAP_ZOOM=14
# MAP_TILE_SIZE=256
# ===== 部署 / 运维（可选）=====
# 监听地址：默认 127.0.0.1；对外开放必须同时设置 AUTH_TOKEN
# HOST=0.0.0.0
# PORT=3000
# Bearer 认证令牌（设置后 /api/* 需要 Authorization: Bearer <token>）
# AUTH_TOKEN=change-me
# 结构化日志级别：debug / info / warn / error / silent
# LOG_LEVEL=info

# ===== 生产模式（PRODUCTION=1 时以下为硬门禁）=====
# 生产必须启用；缺少 AUTH_TOKEN / SESSION_SECRET / DATA_KEY 或仍为 mock 时拒绝启动
# PRODUCTION=1
# NODE_ENV=production
# 登录引导密钥：至少 16 位随机值；浏览器只用它换取 HttpOnly 会话 Cookie
# AUTH_TOKEN=replace-with-random-login-secret
# 会话签名密钥：至少 32 位随机值（openssl rand -base64 48）
# SESSION_SECRET=replace-with-random-session-secret
# 会话有效期（小时，默认 12）
# SESSION_TTL_HOURS=12
# 可选但推荐：Prometheus 专用只读指标令牌（至少 16 位；不能访问 /api/*）
# METRICS_TOKEN=replace-with-random-metrics-token
# 敏感配置 AES-256-GCM 主密钥：必须是 32 字节 base64（openssl rand -base64 32）
# DATA_KEY=replace-with-32-byte-base64-key
# 生产经 HTTPS 反代访问时必须保持 true；本地 HTTP 调试可显式设为 false
# COOKIE_SECURE=true
# 反代部署时设为 1 才信任 X-Forwarded-For / X-Forwarded-Proto
# TRUST_PROXY=1
